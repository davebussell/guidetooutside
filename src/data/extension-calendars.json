    "ucmg-sac": {
      "publisher": "UC Master Gardeners of Sacramento County",
      "title": "Monthly Vegetable Gardening Tips",
      "published": "page updated 8 Jun 2026",
      "url": "https://ucanr.edu/site/uc-master-gardeners-sacramento-county/monthly-vegetable-gardening-tips",
      "read": "2026-11-13",
      "quote": "August: 'Beets, carrots, and other cool-season vegetables can be planted this month', and Florence fennel does better planted in August. September: garlic, 'the optimum planting season is September through mid December'. October: 'There are plenty of leafy greens and other cool-season vegetable plants at garden stores now'. November and December: no planting.",
      "note": "UC's own Sacramento Vegetable Planting Schedule (EHN 11, revised 2016, updated 2017, https://ccfruitandnuts.ucanr.edu/sites/default/files/2017-11/117117.pdf) is the county's calendar, but its month columns do not survive in the PDF's text (opened 13 Nov 2026), so the monthly tips are used, and only for the autumn, where they name the months."
    },
    "ucmg-la": {
      "publisher": "UC Master Gardeners of Los Angeles County",
      "title": "Spring & Summer Gardening Basics for Los Angeles County",
      "published": "undated, posted on UC ANR's site in Nov 2011",
      "url": "https://ccfruitandnuts.ucanr.edu/sites/default/files/2011-11/131790.pdf",
      "read": "2026-11-13",
      "quote": "It is best to wait until the end of April to sow or transplant vegetables and fruits that prefer very warm weather to mature, including beans, corn, cucumbers, eggplants, melons, peppers, pumpkins, and squash.",
      "note": "The guide names no author; its only producer is 'our Master Gardener Helpline', and it is hosted by UC ANR, so it is credited to the county's UC Master Gardener Program. Monthly lists for March to August only. Its March outdoor list also names cucumbers, eggplants, melons and squash; its own sentence above says to wait for the end of April, and that is followed here. Eggplants, peppers and tomatoes sown indoors in March are trays, not sowings."
    },
    "bcmg-bexar": {
      "publisher": "Bexar County Master Gardeners (Texas A&M AgriLife Extension, Bexar County)",
      "title": "Vegetable Planting Calendar",
      "published": "undated web page",
      "url": "https://www.bexarmg.org/may-we-help/vegetable-gardening/vegetable-planting-calendar/",
      "read": "2026-11-14",
      "note": "The page lists, month by month, what to plant, with dates where a window opens or closes inside a month ('starting Aug 20', 'through Sept 10'). A crop listed in consecutive months is read as one window from the first month's opening date (or the 1st) to the last month's closing date (or its last day). Transplants and slips are planting-out windows, as the site's other calendars give them."
    }
