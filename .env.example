# --- Required for AI-written guides (without it the site falls back to a seasonal rules guide) ---
ANTHROPIC_API_KEY=
# Optional: override the model
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://guidetooutside.com

# --- Optional: shared cache so one AI generation serves every visitor to an area for a week ---
# Create a free Redis database at upstash.com (or via Vercel Marketplace) and paste the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monetization (all optional) ---
NEXT_PUBLIC_ADSENSE_CLIENT=        # "ca-pub-" followed by your 16-digit publisher number
NEXT_PUBLIC_AMAZON_TAG=            # e.g. guidetooutside-20 (amazon.com) — .ca tag if you have one
NEXT_PUBLIC_GA_ID=                 # e.g. G-XXXXXXXXXX

# --- Newsletter (pick one) ---
NEWSLETTER_WEBHOOK_URL=            # Zapier / Make / n8n / Beehiiv inbound webhook
BUTTONDOWN_API_KEY=
